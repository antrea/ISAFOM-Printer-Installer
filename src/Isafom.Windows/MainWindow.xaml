              </StackPanel>
            </TabItem.Header>
            <Grid Margin="16,14,16,12" TextElement.FontWeight="Normal">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="120" />
