                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#087F76" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="Attività in tempo reale" FontWeight="SemiBold" FontSize="13" />
