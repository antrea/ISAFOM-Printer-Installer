                    <Rectangle Width="24" Height="3" Fill="#94AAB9" Canvas.Left="110" Canvas.Top="104" RadiusX="1" RadiusY="1" />
                    <Rectangle Width="10" Height="19" Fill="#0D8076" Canvas.Left="51" Canvas.Top="91" RadiusX="2" RadiusY="2" />
