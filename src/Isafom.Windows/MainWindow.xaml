                          <TextBlock x:Name="NameHelp" Text="Inserisci il nome con cui desideri identificare i tuoi documenti sulla stampante (es. Mario Rossi)." Foreground="#63788F" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed" />
                          <TextBlock Text="Fino a 31 caratteri; accenti e apostrofi ammessi." Foreground="#7B8BA0" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                      </Grid>
                      <Border x:Name="FieldDivider" Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#E7EDF4" Margin="0,13,0,13" Visibility="Collapsed" />
                      <Grid x:Name="AccountSection" Grid.Row="0" Grid.ColumnSpan="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Background="#EAF0F6" CornerRadius="7" Width="26" Height="28" VerticalAlignment="Top">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#536B83" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <Label Target="Account" Content="Account ID" Padding="0,0,0,5" FontWeight="SemiBold" FontSize="14" />
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                              <PasswordBox x:Name="Account" MinHeight="36" AutomationProperties.Name="Account ID" MaxLength="4" PreviewTextInput="AccountTextInput" PasswordChanged="AccountChanged" ToolTip="Account ID personale assegnato dal responsabile. Quattro cifre, inclusi gli zeri iniziali; usato anche per la stampa privata." />
                              <Border x:Name="RevealedBorder" Visibility="Collapsed" Background="#F5F9FC" BorderBrush="#087F76" BorderThickness="2" CornerRadius="6" Padding="9,6">
                                <TextBlock x:Name="Revealed" FontSize="14" AutomationProperties.Name="Codice temporaneamente visibile" />
                              </Border>
                            </Grid>
                            <Button x:Name="RevealButton" Grid.Column="1" Margin="10,0,0,0" Padding="9,6" MinHeight="34" Click="RevealClick" ToolTip="Mostra il codice per cinque secondi" AutomationProperties.Name="Mostra Account ID per cinque secondi" FontSize="12">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RevealIcon" Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="RevealLabel" Text="Mostra 5 s" />
                              </StackPanel>
                            </Button>
                          </Grid>
                          <TextBlock x:Name="AccountHelp" Text="Inserisci il codice numerico personale assegnato dall'amministratore dell'Istituto." Foreground="#63788F" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed" />
                          <TextBlock Text="4 cifre · stesso codice per accounting e stampa privata." Foreground="#537998" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </ScrollViewer>
                  <StackPanel Grid.Row="1" Margin="32,9,0,0">
