<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Isafom.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Isafom.Windows" Title="Installazione stampante ISAFOM" Width="920" Height="710" MinWidth="360" MinHeight="300" WindowStartupLocation="CenterScreen" Background="#F2F6FA" FontFamily="Segoe UI" FontSize="13" Foreground="#152D46" Language="it-IT" Icon="Assets/IsafomPrinter.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#087F76" />
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FocusRing" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="#087F76" BorderThickness="2" CornerRadius="8" Margin="-4" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F5F8FB" />
      <Setter Property="Foreground" Value="#16314B" />
      <Setter Property="BorderBrush" Value="#CBD7E3" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.68" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Value="13" Property="FontSize" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#AEBED0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#AEBED0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#506680" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabSurface" Background="Transparent" CornerRadius="8,8,0,0" MinHeight="36" Padding="16,0" Margin="0,0,6,0">
              <Grid>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Border x:Name="Underline" Background="Transparent" Height="3" VerticalAlignment="Bottom" Margin="-16,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#076F67" />
                <Setter TargetName="TabSurface" Property="Background" Value="White" />
                <Setter TargetName="Underline" Property="Background" Value="#087F76" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="#F9FCFE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="JourneyTemplate">
      <StackPanel AutomationProperties.Name="{Binding AccessibleDescription}">
        <Grid Height="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="26" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border x:Name="LeftLine" Height="2" Background="#DFE7EE" VerticalAlignment="Center" />
          <Border x:Name="RightLine" Grid.Column="2" Height="2" Background="#DFE7EE" VerticalAlignment="Center" />
          <Border x:Name="Dot" Grid.Column="1" CornerRadius="13" Background="#F4F7FA" BorderBrush="#D7E1E9" BorderThickness="1">
            <TextBlock x:Name="Symbol" Text="{Binding Symbol}" FontWeight="SemiBold" Foreground="#6F8296" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
          </Border>
        </Grid>
        <TextBlock x:Name="StepLabel" Text="{Binding Label}" HorizontalAlignment="Center" TextAlignment="Center" Margin="3,4,3,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#6D7E90" />
        <TextBlock x:Name="StepDescription" Text="{Binding Description}" Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" HorizontalAlignment="Center" Margin="0,1,0,0" FontSize="10.5" Foreground="#8593A1" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding First}" Value="True">
          <Setter TargetName="LeftLine" Property="Visibility" Value="Hidden" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Last}" Value="True">
          <Setter TargetName="RightLine" Property="Visibility" Value="Hidden" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:JourneyStepState.Active}">
          <Setter TargetName="Dot" Property="Background" Value="#087F76" />
          <Setter TargetName="Dot" Property="BorderBrush" Value="#087F76" />
          <Setter TargetName="Symbol" Property="Foreground" Value="White" />
          <Setter TargetName="StepLabel" Property="Foreground" Value="#076F67" />
          <Setter TargetName="StepDescription" Property="Foreground" Value="#087F76" />
          <Setter TargetName="LeftLine" Property="Background" Value="#73BDB4" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:JourneyStepState.Completed}">
          <Setter TargetName="Dot" Property="Background" Value="#E3F3EE" />
          <Setter TargetName="Dot" Property="BorderBrush" Value="#A6D4C4" />
          <Setter TargetName="Symbol" Property="Foreground" Value="#16835B" />
          <Setter TargetName="LeftLine" Property="Background" Value="#73BDB4" />
          <Setter TargetName="RightLine" Property="Background" Value="#73BDB4" />
          <Setter TargetName="StepLabel" Property="Foreground" Value="#236B59" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:JourneyStepState.Failed}">
          <Setter TargetName="Dot" Property="Background" Value="#B83938" />
          <Setter TargetName="Dot" Property="BorderBrush" Value="#B83938" />
          <Setter TargetName="Symbol" Property="Foreground" Value="White" />
          <Setter TargetName="StepLabel" Property="Foreground" Value="#A93433" />
          <Setter TargetName="StepDescription" Property="Foreground" Value="#A93433" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="LayoutRoot" SizeChanged="LayoutSizeChanged" Background="#F2F6FA">
    <ScrollViewer x:Name="RootScroll" HorizontalContentAlignment="Center" HorizontalScrollBarVisibility="Auto" CanContentScroll="False" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top">
