                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ScrollViewer x:Name="FieldsScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid x:Name="NameSection" Grid.ColumnSpan="1" Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Background="#EAF0F6" CornerRadius="7" Width="26" Height="28" VerticalAlignment="Top">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#536B83" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <Label Target="UserName" Content="Nome" Padding="0,0,0,5" FontWeight="SemiBold" FontSize="14" />
