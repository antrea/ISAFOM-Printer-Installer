        <TabControl x:Name="Pages" Background="Transparent" BorderThickness="0">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Border Background="#EEF3F8" BorderBrush="#D9E4EE" BorderThickness="0,0,0,1">
