                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <TextBlock Text="Installa stampante" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="VerifyButton" Click="VerifyClick" AutomationProperties.Name="Verifica installazione">
