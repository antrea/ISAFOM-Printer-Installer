                    <Rectangle Width="8" Height="7" Fill="#8CCBC6" Canvas.Left="159" Canvas.Top="59" />
                    <Rectangle Width="85" Height="2" Fill="#CFDBE3" Canvas.Left="78" Canvas.Top="98" />
